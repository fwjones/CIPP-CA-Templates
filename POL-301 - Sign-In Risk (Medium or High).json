{
  "SchemaVersion": "1.0",
  "Type": "ConditionalAccess",
  "Metadata": {
    "DisplayName": "POL-301 - Sign-In Risk (Medium or High)",
    "Description": "Triggers Multi-Factor Authentication when Entra Identity Protection flags an active authentication attempt as medium or high risk.",
    "Author": "CIPP Automated Library"
  },
  "Policy": {
    "displayName": "POL-301 - Sign-In Risk (Medium or High)",
    "state": "enabledForReportingButNotEnforced",
    "conditions": {
      "signInRiskLevels": [
        "high",
        "medium"
      ],
      "clientAppTypes": [
        "all"
      ],
      "applications": {
        "includeApplications": [
          "All"
        ],
        "excludeApplications": [],
        "includeUserActions": [],
        "includeAuthenticationContextClassReferences": []
      },
      "users": {
        "includeUsers": [
          "All"
        ],
        "excludeUsers": [],
        "includeGroups": [],
        "excludeGroups": [
          "%%EXCLUDE_GROUP%%"
        ],
        "includeRoles": [],
        "excludeRoles": []
      }
    },
    "grantControls": {
      "operator": "OR",
      "builtInControls": [
        "mfa"
      ]
    }
  }
}
